# ============================================
# אדיאל ג'וניור - הגדרות סביבה (אופציונלי!)
# 🔓 אין כאן אף API key - המערכת 100% ביתית ומקומית
# העתק ל-.env אם רוצה לשנות ברירות מחדל
# ============================================

# פורט ה-Backend (ברירת מחדל 8765)
PORT=8765

# גודל מודל Whisper להאזנה (tiny / base / small / medium)
# small = ברירת מחדל מאוזנת; tiny = מהיר במחשב חלש
WHISPER_MODEL=small

# מצב אופליין מלא - שום דבר לא יוצא לרשת, אפילו edge-tts החינמי
# הקול יעבוד דרך קולות מקוריים + pyttsx3 אופליין
ADIEL_OFFLINE=0
