{
  "name": "adiel-junior-hud",
  "version": "2.4.0",
  "description": "אדיאל ג'וניור - עוזרת AI אישית עם HUD עתידני",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win --config build.config.json",
    "build:dir": "electron-builder --dir --config build.config.json",
    "pack": "electron-builder --dir"
  },
  "keywords": [
    "ai",
    "assistant",
    "hebrew",
    "jarvis",
    "hud"
  ],
  "author": "Adiel Labs",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "build": {
    "appId": "com.adiel.junior",
    "productName": "Adiel Junior",
    "copyright": "Copyright © 2026 Adiel Labs",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src/assets/icon.png",
      "requestedExecutionLevel": "asAdmin"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Adiel-Junior-Portable.exe"
    },
    "extraResources": [
      {
        "from": "../backend/dist/",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../backend/data/",
        "to": "backend/data",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ]
  }
}